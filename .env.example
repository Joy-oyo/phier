# Groq is preferred automatically when this key is present. It handles replies,
# pronunciation guidance, translation fallbacks, and personal memory extraction.
GROQ_API_KEY=
GROQ_TEXT_MODEL=qwen/qwen3.8-27b
# OpenAI is an optional language fallback and is required for speech only when
# TRTC is not configured. There is no automatic fallback to fake data.
PHIER_PROVIDER=openai
# For local speech and generation, use npm run dev:local (see docs/local-mode.md).
# Explicit PHIER_PROVIDER=local overrides the Groq/OpenAI selection.
# PHIER_KNOWLEDGE_PROVIDER=local
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3:4b-instruct
# WHISPER_URL=http://127.0.0.1:8081
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_MEMORY_MODEL=gpt-4.1-mini
# Knowledge sourcing uses OpenAI web search independently of the translation provider.
# Requires Responses API web_search support. Blank uses OPENAI_TEXT_MODEL.
OPENAI_KNOWLEDGE_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIBE_MODEL=gpt-live-transcribe
PORT=5173
PHIER_DB_PATH=./data/phier.sqlite
# Development/test fixtures only. Leave false for real use.
PHIER_ENABLE_DEMO=false
# Optional: TRTC real-time transcription + translation. When both are set, listening
# streams through TRTC instead of the OpenAI speech session and translations arrive
# with the transcript. Requires an RTC-Engine app with speech-to-text enabled.
TRTC_SDK_APP_ID=
TRTC_SDK_SECRET_KEY=
TRTC_SOURCE_LANGUAGE=ja
TRTC_TARGET_LANGUAGE=en
